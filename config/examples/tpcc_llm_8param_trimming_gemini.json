  "continuous_apply": false,
  "tuning_mode": "outside-of-window",
  "llm_model_name": "gemini-2.5-flash-lite",
  "llm_temperature": 0.2,
  "include_param_descriptions": true,
  "llm_prompt_mode": "default",
  "trimming_enabled": true,
  "trimming_cycles": 5,
  "trimming_model_name": "gemini-2.5-flash",
  "trimming_strategy": "single_loop",
  "trimming_suggest_params": true,
  "results_dir": "results/tpcc_llm_8param_trimming_gemini"
